// HealthMate — schema para PostgreSQL (Supabase)
//
// DATABASE_URL -> pooler do Supabase (porta 6543) usado pela API
// DIRECT_URL   -> conexão direta/sessão (porta 5432) usada pelo `prisma migrate`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

// As URLs de conexão ficam em prisma.config.ts (migrations) e em
// src/prisma/prisma.service.ts (runtime, via @prisma/adapter-pg).
datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PROFESSIONAL
  PATIENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MedicamentStatus {
  ACTIVE
  CONCLUDED
  CANCELED
}

/// Conta de acesso ao sistema (hoje: profissionais; no futuro também pacientes).
model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(100)
  email        String    @unique @db.VarChar(255)
  /// null quando a conta só entra com Google
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  googleId     String?   @unique @map("google_id") @db.VarChar(255)
  phone        String?   @db.VarChar(20)
  role         Role      @default(PROFESSIONAL)
  isActive     Boolean   @default(true) @map("is_active")
  /// hash do refresh token atual — permite logout real e rotação
  refreshTokenHash String? @map("refresh_token_hash") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  professional Professional?
  patient      Patient?

  @@map("users")
}

model Professional {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  specialty String?  @db.VarChar(120)
  /// CRM, COREN, CRF...
  license   String?  @db.VarChar(40)
  bio       String?  @db.VarChar(500)
  avatarUrl String?  @map("avatar_url") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  patients    PatientProfessional[]
  assessments HealthAssessment[]

  @@map("professionals")
}

/// Paciente acompanhado por um ou mais profissionais.
/// Não precisa ter conta (userId é opcional).
model Patient {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @unique @map("user_id") @db.Uuid
  name      String    @db.VarChar(100)
  email     String?   @db.VarChar(255)
  phone     String?   @db.VarChar(20)
  gender    Gender?
  birthDate DateTime? @map("birth_date") @db.Date
  /// kg
  weight    Float?
  /// metros
  height    Float?
  bloodType String?   @map("blood_type") @db.VarChar(3)
  /// { street, number, complement, district, city, state, zipCode }
  address   Json?
  notes     String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  professionals PatientProfessional[]
  medicaments   Medicament[]
  assessments   HealthAssessment[]

  @@index([name])
  @@map("patients")
}

model PatientProfessional {
  patientId      String   @map("patient_id") @db.Uuid
  professionalId String   @map("professional_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@id([patientId, professionalId])
  @@index([professionalId])
  @@map("patient_professionals")
}

model Medicament {
  id          String           @id @default(uuid()) @db.Uuid
  patientId   String           @map("patient_id") @db.Uuid
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(500)
  dosage      String?          @db.VarChar(60)
  /// unidades em estoque (comprimidos, doses...) — usado no alerta de recompra
  quantity    Int              @default(0)
  /// abaixo deste valor o dashboard avisa para recomprar
  lowStockAt  Int              @default(5) @map("low_stock_at")
  status      MedicamentStatus @default(ACTIVE)
  startDate   DateTime?        @map("start_date") @db.Date
  endDate     DateTime?        @map("end_date") @db.Date
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  reminders Reminder[]

  @@index([patientId])
  @@map("medicaments")
}

/// Horário diário de administração de um medicamento.
model Reminder {
  id           String   @id @default(uuid()) @db.Uuid
  medicamentId String   @map("medicament_id") @db.Uuid
  /// "HH:mm" (24h)
  time         String   @db.VarChar(5)
  message      String?  @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  medicament Medicament @relation(fields: [medicamentId], references: [id], onDelete: Cascade)

  @@unique([medicamentId, time])
  @@map("reminders")
}

/// Avaliação de saúde registrada por um profissional — base dos relatórios.
model HealthAssessment {
  id             String   @id @default(uuid()) @db.Uuid
  patientId      String   @map("patient_id") @db.Uuid
  professionalId String?  @map("professional_id") @db.Uuid
  symptoms       String?  @db.Text
  sideEffects    String?  @map("side_effects") @db.Text
  observations   String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  @@index([patientId, createdAt])
  @@map("health_assessments")
}
