# ─── Banco (Supabase → Project Settings → Database → Connection string) ───
# Pooler "Transaction" (porta 6543) — usado pela API em runtime
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<SENHA>@aws-0-<REGIAO>.pooler.supabase.com:6543/postgres"
# Conexão direta / pooler "Session" (porta 5432) — usada pelo prisma migrate
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<SENHA>@aws-0-<REGIAO>.pooler.supabase.com:5432/postgres"

# ─── API ───
PORT=3333
NODE_ENV=development
# URL(s) do front autorizadas no CORS, separadas por vírgula
FRONTEND_URL=http://localhost:3000

# ─── Auth ───
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=troque-isto-por-um-segredo-longo
JWT_REFRESH_SECRET=troque-isto-por-outro-segredo-longo
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Opcional — habilita "Entrar com Google" (Google Cloud Console → OAuth Client ID tipo Web)
GOOGLE_CLIENT_ID=
